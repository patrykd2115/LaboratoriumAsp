@model Book
<tr>
    <td><a asp-action="Details" asp-route-id="@Model.Id"> @Model.Title</a></td>
    <td>@Model.Author</td>
    <td>@Model.Price.ToString("C")</td>
    <td>
        <a class="btn btn-danger" asp-controller="Book" asp-action="Edit" asp-route-id="@Model.Id">Edytuj</a>
        <a class="btn btn-success" asp-controller="Book" asp-action="Delete" asp-route-id="@Model.Id">Usuń</a>
    </td>
    
</tr>